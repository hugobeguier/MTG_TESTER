{
  "schemaVersion": 2,
  "abilities": [
    {
      "id": "a1",
      "kind": "triggered",
      "text": "When this creature enters, create a Food token, then you may exile three cards from your graveyard. If you do, repeat this process.",
      "trigger": {
        "event": "etb",
        "subject": "self"
      },
      "steps": [
        {
          "kind": "create_tokens",
          "tokenCount": 1,
          "tokenName": "Food",
          "tokenColors": [
            "colorless"
          ],
          "tokenTypeLine": "Artifact — Food",
          "id": "s1",
          "src": 0
        },
        {
          "kind": "move_card_zone",
          "id": "s2",
          "optional": true,
          "who": "you",
          "from": "graveyard",
          "moveTo": "exile",
          "filter": {
            "zone": "graveyard",
            "owner": "you"
          },
          "count": 3,
          "src": 0,
          "prompt": {
            "title": "Insatiable Frugivore: optional",
            "instruction": "Do you want to exile a card?",
            "source": {
              "card": "Insatiable Frugivore",
              "ability": "a1"
            }
          }
        },
        {
          "kind": "if_else",
          "src": 1,
          "if": {
            "check": "step_done",
            "step": "s2"
          },
          "then": [
            {
              "kind": "repeat_for_each",
              "repeatProcess": {
                "from": "s1",
                "through": "s2"
              }
            }
          ]
        }
      ],
      "implementation": "needed",
