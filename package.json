{
  "name": "mtg-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cards:import": "node scripts/import-commander-cards.mjs",
    "xmage:ingest": "node scripts/ingest-xmage-cards.mjs",
    "bench:agents": "node scripts/agent-bench.mjs",
    "agent:mistakes": "vite-node -c vitest.config.ts scripts/agent-mistakes.ts --",
    "selfplay": "vite-node -c vitest.config.ts scripts/self-play.ts --",
    "backlog": "vite-node -c vitest.config.ts scripts/card-backlog.ts",
    "choice-audit": "vite-node -c vitest.config.ts scripts/choice-audit.ts",
    "test": "vitest run",
    "kernel:validate-drafts": "vite-node -c vitest.config.ts scripts/validate-kernel-drafts.ts --",
    "kernel:check-copies": "vite-node -c vitest.config.ts scripts/check-kernel-copies.ts",
    "kernel:ai-selfplay": "vite-node -c vitest.config.ts scripts/kernel-ai-selfplay.ts --",
    "kernel:observe": "vite-node -c vitest.config.ts scripts/kernel-observer.ts --",
    "kernel:observe-replay": "vite-node -c vitest.config.ts scripts/kernel-observe-replay.ts --",
    "kernel:readiness": "vite-node -c vitest.config.ts scripts/kernel-readiness.ts --",
    "unresolved:report": "vite-node -c vitest.config.ts scripts/unresolved-report.ts --",
    "kernel:bundle-drafts": "vite-node -c vitest.config.ts scripts/kernel-bundle-drafts.ts --",
    "kernel:audit-support": "vite-node -c vitest.config.ts scripts/audit-support.ts",
    "kernel:overview": "vite-node -c vitest.config.ts scripts/gen-kernel-overview.ts",
    "audit:deck-cards": "vite-node -c vitest.config.ts scripts/deck-card-audit.ts",
    "audit:abilities": "vite-node -c vitest.config.ts scripts/ability-audit.ts --"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "next": "^15.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.185.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.185.1",
    "playwright": "^1.61.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
